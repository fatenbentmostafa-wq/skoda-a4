{
  "appId": "com.kareem.skoda",
  "appName": "صيانة سكودا",
  "webDir": "www",
  "server": {
    "url": "https://fatenbentmostafa-wq.github.io/skoda-a4/",
    "cleartext": false,
    "errorPath": "offline.html",
    "androidScheme": "https",
    "allowNavigation": [
      "accounts.google.com",
      "*.google.com",
      "apis.google.com",
      "masareef-elbeit.firebaseapp.com",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a1411",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0a1411",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}
